{
  "name": "okfetch",
  "productName": "OKfetch",
  "version": "1.0.0",
  "description": "OKfetch – peer-to-peer messages and files, encrypted or plain",
  "author": "OpiKula",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:two": "node scripts/dev-two.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "electron-vite build && node tests/smoke/run-smoke.mjs",
    "smoke:relay": "electron-vite build && node tests/smoke/run-smoke-relay.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && node -r ./scripts/extract-uninstaller.cjs node_modules/electron-builder/cli.js --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:worklet": "node scripts/build-worklet.mjs",
    "apk": "npm run build:mobile && npm run build:worklet && npx cap sync android && node scripts/build-apk.mjs",
    "smoke:mobile": "node tests/smoke/run-mobile-ui.mjs",
    "smoke:android": "node tests/smoke/run-android.mjs",
    "smoke:android:request": "node tests/smoke/run-android-request.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "b4a": "^1.6.7",
    "dompurify": "^3.2.6",
    "hyperswarm": "^4.11.7",
    "sodium-universal": "^5.0.1",
    "uqr": "^0.1.3",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "hash-wasm": "^4.12.0",
    "hyperdht": "^6.20.5",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
