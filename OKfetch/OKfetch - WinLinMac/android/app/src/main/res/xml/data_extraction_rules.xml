<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing from OKfetch goes into cloud backups or device transfers: the keys are bound to this phone's Keystore.
     Moving to another phone goes through Settings → Storage → Backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
