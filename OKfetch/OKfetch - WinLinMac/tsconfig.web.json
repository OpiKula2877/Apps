{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "composite": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "src/mobile/rpc.ts",
    "src/core/settings.ts",
    "tests/editor.test.ts"
  ]
}
