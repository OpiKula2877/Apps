{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true
  },
  "include": [
    "electron.vite.config.ts",
    "src/core/**/*",
    "src/main/**/*",
    "src/mobile/**/*",
    "src/preload/**/*",
    "src/renderer/src/i18n/strings.ts",
    "src/renderer/src/mobile/mobileApi.ts",
    "src/shared/**/*",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["tests/editor.test.ts"]
}
